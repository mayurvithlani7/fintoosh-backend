# Production Environment Variables Template
# Copy this file to .env.production and fill in your actual values

# Server Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration (MongoDB Atlas)
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/your-database?retryWrites=true&w=majority&appName=your-app-name

# Authentication
# Generate a secure random JWT secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secure-jwt-secret-here

# Email Service (SendGrid)
# Get your API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Monitoring (Optional - configure if using)
SENTRY_DSN=https://your-sentry-dsn-here

# Rate Limiting (Optional - adjust for production load)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Origins (Update with your production domains)
ALLOWED_ORIGINS=https://fintoosh.com,https://www.fintoosh.com,https://app.fintoosh.com

# Security Headers (Optional)
SECURITY_HEADERS_ENABLED=true

# Logging Level
LOG_LEVEL=warn

# API Documentation (Optional)
API_DOCS_ENABLED=false
