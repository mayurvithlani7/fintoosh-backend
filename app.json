{
  "expo": {
    "name": "Fintoosh",
    "slug": "fintoosh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Fintoosh.png",
    "scheme": "fintoosh",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ffffff",
    "primaryColor": "#6A49F3",
    "description": "Wise Kids. Smarter Money. - A family finance management app for parents and children to learn money management through fun tasks and games.",
    "privacy": "public",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fintoosh.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access for future features",
        "NSMicrophoneUsageDescription": "This app requires microphone access for future features",
        "NSPhotoLibraryUsageDescription": "This app requires photo library access for future features"
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "enableOnBackInvokedCallback": true,
      "web": {
        "output": "static",
        "favicon": "./assets/images/favicon.png"
      },
      "plugins": [
        "expo-router",
        [
          "expo-splash-screen",
          {
            "image": "./assets/images/Fintoosh.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#ffffff",
            "dark": {
              "backgroundColor": "#000000"
            }
          }
        ],
        "expo-secure-store"
      ],
      "experiments": {
        "typedRoutes": true,
        "reactCompiler": true
      },
      "runtimeVersion": "1.0.0",
      "package": "com.fintoosh.app"
    },
    "plugins": [
      "expo-router",
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0efc0d70-a8d1-4b53-819c-0020d24b9196"
      }
    }
  }
}
